<UserControl
    x:Class="ImpulsaExplorer.Controls.BrowserPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ImpulsaExplorer.Models">

    <Grid Background="{StaticResource CloverWindowBrush}" Padding="{StaticResource CloverPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CloverPanelBrush}"
                BorderBrush="{StaticResource CloverBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                Margin="0,0,0,8">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource CloverNavigationButtonStyle}" Click="BackButton_Click" ToolTipService.ToolTip="Atrás">
                    <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                </Button>
                <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource CloverNavigationButtonStyle}" Click="ForwardButton_Click" ToolTipService.ToolTip="Adelante">
                    <FontIcon Glyph="&#xE72A;" FontSize="16"/>
                </Button>
                <Button x:Name="UpButton" Grid.Column="2" Style="{StaticResource CloverNavigationButtonStyle}" Click="UpButton_Click" ToolTipService.ToolTip="Subir un nivel">
                    <FontIcon Glyph="&#xE74A;" FontSize="16"/>
                </Button>

                <TextBox x:Name="AddressBox"
                         Grid.Column="3"
                         Style="{StaticResource CloverAddressBoxStyle}"
                         KeyDown="AddressBox_KeyDown"
                         PlaceholderText="Escribí una ruta o pegala aquí"/>

                <Button x:Name="RefreshButton" Grid.Column="4" Style="{StaticResource CloverNavigationButtonStyle}" Click="RefreshButton_Click" ToolTipService.ToolTip="Actualizar">
                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource CloverPanelBrush}"
                BorderBrush="{StaticResource CloverBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,8">
            <CommandBar DefaultLabelPosition="Collapsed" IsOpen="False" Background="Transparent" Foreground="{StaticResource CloverTextBrush}">
                <AppBarButton Icon="Add" Label="Nueva carpeta" Click="NewFolderButton_Click" ToolTipService.ToolTip="Nueva carpeta"/>
                <AppBarSeparator/>
                <AppBarButton Icon="Cut" Label="Cortar" Click="CutButton_Click" ToolTipService.ToolTip="Cortar"/>
                <AppBarButton Icon="Copy" Label="Copiar" Click="CopyButton_Click" ToolTipService.ToolTip="Copiar"/>
                <AppBarButton Icon="Paste" Label="Pegar" Click="PasteButton_Click" ToolTipService.ToolTip="Pegar"/>
                <AppBarSeparator/>
                <AppBarButton Icon="Rename" Label="Renombrar" Click="RenameButton_Click" ToolTipService.ToolTip="Renombrar"/>
                <AppBarButton Icon="Delete" Label="Papelera" Click="DeleteButton_Click" ToolTipService.ToolTip="Enviar a la Papelera"/>
                <AppBarSeparator/>
                <AppBarButton Icon="Favorite" Label="Favorito" Click="FavoriteButton_Click" ToolTipService.ToolTip="Agregar o quitar de Favoritos"/>
            </CommandBar>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource CloverPanelBrush}"
                    BorderBrush="{StaticResource CloverBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Explorador"
                               Margin="10,8,10,6"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource CloverMutedTextBrush}"/>

                    <ListView x:Name="QuickAccessList"
                              Grid.Row="1"
                              IsItemClickEnabled="True"
                              ItemClick="QuickAccessList_ItemClick"
                              SelectionMode="None"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="MinHeight" Value="34"/>
                                <Setter Property="Margin" Value="2,1"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:QuickLocation">
                                <Grid Height="32" ColumnSpacing="10" Padding="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource CloverAccentBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource CloverTextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource CloverPanelBrush}"
                    BorderBrush="{StaticResource CloverBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Padding="12,8"
                          ColumnSpacing="8"
                          Background="{StaticResource CloverPanelAltBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Nombre" FontWeight="SemiBold" Foreground="{StaticResource CloverTextBrush}"/>
                        <TextBlock Grid.Column="2" Text="Tipo" FontWeight="SemiBold" Foreground="{StaticResource CloverTextBrush}"/>
                        <TextBlock Grid.Column="3" Text="Modificado" FontWeight="SemiBold" Foreground="{StaticResource CloverTextBrush}"/>
                        <TextBlock Grid.Column="4" Text="Tamaño" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource CloverTextBrush}"/>
                    </Grid>

                    <ListView x:Name="FilesListView"
                              Grid.Row="1"
                              ItemsSource="{x:Bind Entries}"
                              SelectionMode="Extended"
                              DoubleTapped="FilesListView_DoubleTapped"
                              SelectionChanged="FilesListView_SelectionChanged"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="MinHeight" Value="38"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FileEntry">
                                <Grid MinHeight="38" Padding="10,2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="17" VerticalAlignment="Center" Foreground="{StaticResource CloverAccentBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource CloverTextBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind TypeLabel}" VerticalAlignment="Center" Foreground="{StaticResource CloverMutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind ModifiedDisplay}" VerticalAlignment="Center" Foreground="{StaticResource CloverMutedTextBrush}"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind SizeDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource CloverMutedTextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="4,7,4,0">
            <TextBlock x:Name="StatusText" Text="Listo" FontSize="12" Foreground="{StaticResource CloverMutedTextBrush}"/>
            <ProgressRing x:Name="BusyRing" Width="16" Height="16" HorizontalAlignment="Right" IsActive="False" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
