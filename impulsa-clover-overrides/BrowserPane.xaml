<UserControl
    x:Class="ImpulsaExplorer.Controls.BrowserPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ImpulsaExplorer.Models">

    <Grid Background="{StaticResource CloverWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="8,4" ColumnSpacing="4" Background="{StaticResource CloverToolbarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource CloverNavigationButtonStyle}" Click="BackButton_Click" ToolTipService.ToolTip="Atrás">
                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource CloverNavigationButtonStyle}" Click="ForwardButton_Click" ToolTipService.ToolTip="Adelante">
                <FontIcon Glyph="&#xE72A;" FontSize="16"/>
            </Button>
            <Button x:Name="UpButton" Grid.Column="2" Style="{StaticResource CloverNavigationButtonStyle}" Click="UpButton_Click" ToolTipService.ToolTip="Subir un nivel">
                <FontIcon Glyph="&#xE74A;" FontSize="16"/>
            </Button>
            <Button x:Name="HomeButton" Grid.Column="3" Style="{StaticResource CloverNavigationButtonStyle}" Click="HomeButton_Click" ToolTipService.ToolTip="Inicio">
                <FontIcon Glyph="&#xE80F;" FontSize="16"/>
            </Button>

            <Grid Grid.Column="4" Margin="4,0">
                <TextBox x:Name="AddressBox"
                         Style="{StaticResource CloverAddressBoxStyle}"
                         KeyDown="AddressBox_KeyDown"
                         PlaceholderText="Ruta"/>
            </Grid>

            <Button x:Name="RefreshButton" Grid.Column="5" Style="{StaticResource CloverNavigationButtonStyle}" Click="RefreshButton_Click" ToolTipService.ToolTip="Actualizar">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CloverCommandBrush}" BorderBrush="{StaticResource CloverBorderBrush}" BorderThickness="0,1,0,1">
            <CommandBar DefaultLabelPosition="Collapsed" IsOpen="False" Background="Transparent" Foreground="{StaticResource CloverTextBrush}">
                <AppBarButton Icon="Add" Label="Nueva carpeta" Click="NewFolderButton_Click" ToolTipService.ToolTip="Nueva carpeta"/>
                <AppBarSeparator/>
                <AppBarButton Icon="Cut" Label="Cortar" Click="CutButton_Click" ToolTipService.ToolTip="Cortar"/>
                <AppBarButton Icon="Copy" Label="Copiar" Click="CopyButton_Click" ToolTipService.ToolTip="Copiar"/>
                <AppBarButton Icon="Paste" Label="Pegar" Click="PasteButton_Click" ToolTipService.ToolTip="Pegar"/>
                <AppBarSeparator/>
                <AppBarButton Icon="Rename" Label="Renombrar" Click="RenameButton_Click" ToolTipService.ToolTip="Renombrar"/>
                <AppBarButton Icon="Delete" Label="Papelera" Click="DeleteButton_Click" ToolTipService.ToolTip="Enviar a la Papelera"/>
                <AppBarSeparator/>
                <AppBarButton Icon="Favorite" Label="Favorito" Click="FavoriteButton_Click" ToolTipService.ToolTip="Favorito"/>
            </CommandBar>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource CloverSidebarBrush}" Padding="6,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Navegación" Margin="10,4,8,6" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CloverMutedTextBrush}"/>

                <ListView x:Name="QuickAccessList"
                          Grid.Row="1"
                          IsItemClickEnabled="True"
                          ItemClick="QuickAccessList_ItemClick"
                          SelectionMode="None"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="MinHeight" Value="34"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:QuickLocation">
                            <Grid Height="34" ColumnSpacing="10" Padding="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource CloverAccentBrush}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource CloverTextBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource CloverBorderBrush}"/>

            <Grid Grid.Column="2" Background="{StaticResource CloverPanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="10,0" ColumnSpacing="8" Background="{StaticResource CloverHeaderBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Nombre" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource CloverTextBrush}"/>
                    <TextBlock Grid.Column="2" Text="Tipo" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource CloverTextBrush}"/>
                    <TextBlock Grid.Column="3" Text="Fecha de modificación" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource CloverTextBrush}"/>
                    <TextBlock Grid.Column="4" Text="Tamaño" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource CloverTextBrush}"/>
                </Grid>

                <ListView x:Name="FilesListView"
                          Grid.Row="1"
                          ItemsSource="{x:Bind Entries}"
                          SelectionMode="Extended"
                          DoubleTapped="FilesListView_DoubleTapped"
                          SelectionChanged="FilesListView_SelectionChanged"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="MinHeight" Value="36"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileEntry">
                            <Grid MinHeight="36" Padding="10,1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="155"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="24" Height="24" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{StaticResource CloverAccentBrush}"/>
                                    <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="24" Height="24" Stretch="Uniform"/>
                                </Grid>

                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource CloverTextBrush}"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind TypeLabel}" VerticalAlignment="Center" Foreground="{StaticResource CloverMutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind ModifiedDisplay}" VerticalAlignment="Center" Foreground="{StaticResource CloverMutedTextBrush}"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind SizeDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource CloverMutedTextBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Background="{StaticResource CloverStatusBrush}" Padding="10,0">
            <TextBlock x:Name="StatusText" Text="Listo" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource CloverMutedTextBrush}"/>
            <ProgressRing x:Name="BusyRing" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
